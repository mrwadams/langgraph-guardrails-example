# Anthropic API Key (required for LLM-based guardrails)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API Key (if using OpenAI embeddings)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: LM Studio Configuration (for local embeddings with OpenAI-compatible API)
# Download LM Studio from: https://lmstudio.ai/
# LM_STUDIO_BASE_URL=http://localhost:1234/v1  # Default LM Studio endpoint
# LM_STUDIO_EMBEDDING_MODEL=your-model-name     # The embedding model you loaded in LM Studio

# Optional: Guardrail Configuration
# GUARDRAIL_SAFETY_LEVEL=moderate  # strict, moderate, or permissive
# GUARDRAIL_MODEL=claude-haiku-4-5  # Model for LLM-based guardrails (default: Claude 4.5 Haiku)
