# Anthropic API Key (required for LLM-based guardrails)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API Key (if using OpenAI models)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Guardrail Configuration
# GUARDRAIL_SAFETY_LEVEL=moderate  # strict, moderate, or permissive
# GUARDRAIL_MODEL=claude-haiku-4-5  # Model for LLM-based guardrails (default: Claude 4.5 Haiku)
